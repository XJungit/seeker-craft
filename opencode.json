{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "opencode-goal-plugin",
      {
        "completionAudit": true
      }
    ],
    "opencode-vibeguard",
    "opencode-pty"
  ],
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  }
}
